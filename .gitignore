# 构建产物
# /dist/ 同时是 goreleaser 与 make cross 的输出目录（gitignore 不支持行尾注释，注释单独成行）
/bin/
/dist/
/data/
# e2e 验收日志（make test-e2e 产出，失败时由 CI 上传为 artifact）
/.e2e-logs/

# 部署：制品与部署根目录都是运行时状态，不入库（Docker 场景见 .dockerignore）
/artifacts/
/.leadstack/
/.deploy-root/
/deploy-root/

# 备份与恢复的运行时文件（日常备份 / verify_backup.sh 产出，**绝不可入库**）
#   backup.pass 是解密备份的唯一钥匙，一旦提交等于把备份内容公开
data/backups/
*.lsbak
*.pre-restore-*/
backup.pass

# 前端依赖与产物
node_modules/
web/node_modules/
web/dist/
web/.vite/
# go:embed 的前端产物（由 make build / make web-embed 生成）
/internal/webui/dist/

# 数据库与本地状态
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# 凭证 / 本地环境
.env
.env.*
!.env.example
deploy/*.env
data/*.env

# 测试与覆盖率
coverage.out
coverage.html
*.test
*.prof

# goreleaser 本地快照与容器运行时（本地验证用，不入库）
/.colima/
.colima/
# 容器冒烟卷/临时数据（docker-check 用命名卷，不会落在仓库；这里兜底防手滑）
/.docker/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.swp
*~
